# Caddy = reverse proxy + HTTPS otomatis (Let's Encrypt).
# Pasang: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile (ganti domain), lalu
#   sudo systemctl reload caddy
#
# --- Dengan domain (REKOMENDASI: HTTPS otomatis) ---
# Ganti example.com dengan domainmu (buat A record → IP statis VM).
example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3737
}

# --- Tanpa domain (tes cepat via IP, HTTP saja) ---
# Hapus blok di atas dan pakai ini:
# :80 {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:3737
# }
